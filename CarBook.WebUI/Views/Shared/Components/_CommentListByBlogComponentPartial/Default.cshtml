@model List<ResultCommentDto>

@{
    var count = Model != null ? Model.Count : 0;
}

<div class="pt-5 mt-5">

    <h3 class="mb-5">@count Yorum</h3>

    @if (Model != null && Model.Any())
    {
        <ul class="comment-list">
            @foreach (var item in Model)
            {
                <li class="comment">
                    <div class="comment-body" style="width: 100%; float: none;">
                        <h3>@item.Name</h3>

                        <div class="meta">
                            @item.CreatedDate.ToString("dd.MM.yyyy HH:mm")
                        </div>

                        <p>
                            @item.Description
                        </p>
                    </div>
                </li>
            }
        </ul>
    }
    else
    {
        <p class="text-muted">Bu bloğa henüz yorum yapılmamış. İlk yorumu siz yapın!</p>
    }

</div>