@model List<CarBook.Dto.ReviewDtos.ResultReviewByCarIdDto>

@{
	int totalReviews = Model != null ? Model.Count : 0;
	int star5 = Model != null ? Model.Count(x => x.RaytingValue == 5) : 0;
	int star4 = Model != null ? Model.Count(x => x.RaytingValue == 4) : 0;
	int star3 = Model != null ? Model.Count(x => x.RaytingValue == 3) : 0;
	int star2 = Model != null ? Model.Count(x => x.RaytingValue == 2) : 0;
	int star1 = Model != null ? Model.Count(x => x.RaytingValue == 1) : 0;

	int pct5 = totalReviews > 0 ? (int)Math.Round((double)star5 * 100 / totalReviews) : 0;
	int pct4 = totalReviews > 0 ? (int)Math.Round((double)star4 * 100 / totalReviews) : 0;
	int pct3 = totalReviews > 0 ? (int)Math.Round((double)star3 * 100 / totalReviews) : 0;
	int pct2 = totalReviews > 0 ? (int)Math.Round((double)star2 * 100 / totalReviews) : 0;
	int pct1 = totalReviews > 0 ? (int)Math.Round((double)star1 * 100 / totalReviews) : 0;
}

<div class="tab-pane fade" id="pills-review" role="tabpanel" aria-labelledby="pills-review-tab">
	<div class="row">
		<div class="col-md-7">
			<h3 class="head">@totalReviews Değerlendirme</h3>
			@if (Model != null && Model.Any())
			{
				@foreach (var item in Model)
				{
					<div class="review d-flex">
						<div class="user-img" style="background-image: url('@(item.CustomerImage ?? "/carbook-master/images/person_1.jpg")');"></div>
						<div class="desc">
							<h4>
								<span class="text-left">@item.CustomerName</span>
								<span class="text-right">@item.ReviewDate.ToShortDateString()</span>
							</h4>
							<p class="star">
								<span>
									@for (int i = 0; i < (item.RaytingValue > 0 ? item.RaytingValue : 5); i++)
									{
										<i class="ion-ios-star"></i>
									}
								</span>
							</p>
							<p>@item.Comment</p>
						</div>
					</div>
				}
			}
			else
			{
				<p class="text-muted">Bu araç için henüz kullanıcı değerlendirmesi yapılmamıştır.</p>
			}
		</div>
		<div class="col-md-5">
			<div class="rating-wrap">
				<h3 class="head">Değerlendirme Sonuçları</h3>
				<div class="wrap">
					<p class="star">
						<span>
							<i class="ion-ios-star"></i>
							<i class="ion-ios-star"></i>
							<i class="ion-ios-star"></i>
							<i class="ion-ios-star"></i>
							<i class="ion-ios-star"></i>
							(@(pct5)%)
						</span>
						<span>@star5 Değerlendirme</span>
					</p>
					<p class="star">
						<span>
							<i class="ion-ios-star"></i>
							<i class="ion-ios-star"></i>
							<i class="ion-ios-star"></i>
							<i class="ion-ios-star"></i>
							(@(pct4)%)
						</span>
						<span>@star4 Değerlendirme</span>
					</p>
					<p class="star">
						<span>
							<i class="ion-ios-star"></i>
							<i class="ion-ios-star"></i>
							<i class="ion-ios-star"></i>
							(@(pct3)%)
						</span>
						<span>@star3 Değerlendirme</span>
					</p>
					<p class="star">
						<span>
							<i class="ion-ios-star"></i>
							<i class="ion-ios-star"></i>
							(@(pct2)%)
						</span>
						<span>@star2 Değerlendirme</span>
					</p>
					<p class="star">
						<span>
							<i class="ion-ios-star"></i>
							(@(pct1)%)
						</span>
						<span>@star1 Değerlendirme</span>
					</p>
				</div>
			</div>
		</div>
	</div>
</div>
