@using CarBook.Dto.FooterAddressDtos
@model ResultFooterAddressDto

<footer class="ftco-footer ftco-bg-dark ftco-section">
    <div class="container">
        <div class="row mb-5">

            <!-- CarBook -->
            <div class="col-md">
                <div class="ftco-footer-widget mb-4">

                    <h2 class="ftco-heading-2">
                        <a href="#" class="logo">
                            Car<span>Book</span>
                        </a>
                    </h2>

                    <p>
                        @Model.Description
                    </p>

                    <ul class="ftco-footer-social list-unstyled float-md-left float-lft mt-5">
                        <li class="ftco-animate">
                            <a href="#"><span class="icon-twitter"></span></a>
                        </li>

                        <li class="ftco-animate">
                            <a href="#"><span class="icon-facebook"></span></a>
                        </li>

                        <li class="ftco-animate">
                            <a href="#"><span class="icon-instagram"></span></a>
                        </li>
                    </ul>

                </div>
            </div>


            <!-- Bilgilendirme -->
            <div class="col-md">
                <div class="ftco-footer-widget mb-4 ml-md-5">

                    <h2 class="ftco-heading-2">Bilgilendirme</h2>

                    <ul class="list-unstyled">
                        <li>
                            <a href="/About/Index" class="py-2 d-block">
                                Hakkımızda
                            </a>
                        </li>

                        <li>
                            <a href="/Service/Index" class="py-2 d-block">
                                Hizmetlerimiz
                            </a>
                        </li>

                        <li>
                            <a href="#" class="py-2 d-block">
                                Şartlar ve Koşullar
                            </a>
                        </li>

                        <li>
                            <a href="#" class="py-2 d-block">
                                Gizlilik Politikası
                            </a>
                        </li>
                    </ul>

                </div>
            </div>


            <!-- Müşteri Desteği -->
            <div class="col-md">
                <div class="ftco-footer-widget mb-4">

                    <h2 class="ftco-heading-2">Müşteri Desteği</h2>

                    <ul class="list-unstyled">

                        <li>
                            <a href="#" class="py-2 d-block">
                                Sıkça Sorulan Sorular
                            </a>
                        </li>

                        <li>
                            <a href="/CarPricing/Index" class="py-2 d-block">
                                Fiyatlandırma
                            </a>
                        </li>

                        <li>
                            <a href="#" class="py-2 d-block">
                                Rezervasyon
                            </a>
                        </li>

                        <li>
                            <a href="/Contact/Index" class="py-2 d-block">
                                İletişim
                            </a>
                        </li>

                    </ul>

                </div>
            </div>


            <!-- İletişim -->
            <div class="col-md">
                <div class="ftco-footer-widget mb-4">

                    <h2 class="ftco-heading-2">İletişim</h2>

                    <div class="block-23 mb-3">
                        <ul>

                            <li>
                                <span class="icon icon-map-marker"></span>
                                <span class="text">
                                    @Model.Address
                                </span>
                            </li>

                            <li>
                                <a href="tel:@Model.Phone">
                                    <span class="icon icon-phone"></span>
                                    <span class="text">
                                        @Model.Phone
                                    </span>
                                </a>
                            </li>

                            <li>
                                <a href="mailto:@Model.Email">
                                    <span class="icon icon-envelope"></span>
                                    <span class="text">
                                        @Model.Email
                                    </span>
                                </a>
                            </li>

                        </ul>
                    </div>

                </div>
            </div>

        </div>


        <div class="row">
            <div class="col-md-12 text-center">

                <p>
                    Copyright &copy;
                    <script>
                                            document.write(new Date().getFullYear());
                    </script>
                    CarBook | Tüm Hakları Saklıdır.
                </p>

            </div>
        </div>

    </div>
</footer>