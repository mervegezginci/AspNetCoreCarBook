@model List<CarBook.Dto.CarDtos.ResultCarWithBrandsDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/UILayout/Index.cshtml";
}

<section class="ftco-section bg-light">
    <div class="container">

        @if (ViewBag.locationID != null || ViewBag.pickDate != null)
        {
            <div class="alert text-center mb-5 p-3 rounded" style="background-color: #e8f4fd; border: 1px solid #b6e0fe; color: #084298;">
                <h5 class="mb-1" style="font-weight: 600;">Arama Sonucunuza Uygun Araçlar Listelendi</h5>
                <p class="mb-0" style="font-size: 14px;">Belirlediğiniz alış/teslim tarihlerine ve konum kriterlerinize uygun araç seçenekleri aşağıda sunulmuştur.</p>
            </div>
        }

        <div class="row">

            @foreach (var item in Model)
            {
                <div class="col-md-4">
                    <div class="car-wrap rounded ftco-animate">

                        <div class="img rounded d-flex align-items-end"
                             style="background-image: url('@item.CoverImageUrl');">
                        </div>

                        <div class="text">

                            <h2 class="mb-0">
                                <a href="/Car/CarDetail/@item.CarId">
                                    @item.Model
                                </a>
                            </h2>

                            <div class="d-flex mb-3">
                                <span class="cat">@item.BrandName</span>

                                <p class="price ml-auto">
                                    @item.PricingAmount.ToString("N0") ₺
                                    <span>/gün</span>
                                </p>
                            </div>

                            <p class="d-flex mb-0 d-block">
                                <a href="/Reservation/Index/@item.CarId" class="btn btn-primary py-2 mr-1">
                                    Hemen Kirala
                                </a>

                                <a href="/Car/CarDetail/@item.CarId"
                                   class="btn btn-secondary py-2 ml-1">
                                    Detaylar
                                </a>
                            </p>

                        </div>

                
                    </div>
                </div>
            }

        </div>

    </div>
</section>