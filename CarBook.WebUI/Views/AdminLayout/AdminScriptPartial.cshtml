<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>


<script>
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("https://localhost:7046/notificationhub")
        .withAutomaticReconnect()
        .build();

     connection.on("ReceiveNotification", function (title, message) {

        const countElement =
            document.getElementById("notificationCount");

        let count = parseInt(countElement.innerText) || 0;

    count++;
    countElement.innerText = count;
    countElement.style.display = "flex";


        const notificationList =
            document.getElementById("notificationList");

        const noNotification =
            document.getElementById("noNotification");

        if (noNotification) {
            noNotification.remove();
        }


        const notificationHtml = `
            <a href="#" class="text-reset notification-item">
                <div class="media">

                    <div class="avatar-xs mr-3">
                        <span class="avatar-title bg-primary rounded-circle">
                            <i class="mdi mdi-bell-outline"></i>
                        </span>
                    </div>

                    <div class="media-body">

                        <h6 class="mt-0 mb-1">
                            ${title}
                        </h6>

                        <p class="font-size-12 mb-1">
                            ${message}
                        </p>

                        <p class="font-size-12 mb-0 text-muted">
                            <i class="mdi mdi-clock-outline"></i>
                            Şimdi
                        </p>

                    </div>

                </div>
            </a>
        `;

        notificationList.insertAdjacentHTML(
            "afterbegin",
            notificationHtml
        );
    });


    connection.start()
        .then(function () {
            console.log("SignalR bağlantısı kuruldu.");
        })
        .catch(function (err) {
            console.error("SignalR bağlantı hatası:", err);
        });
</script>

<!-- Otomatik Breadcrumb (Sayfa Yolu) Scripti -->
<script>
    $(function () {
        if ($('.page-title-box').length === 0 && $('.container-fluid').length > 0) {
            var currentPath = window.location.pathname.toLowerCase();
            var pageTitle = "Yönetim Paneli";

            var titleMap = {
                'dashboard': 'Dashboard',
                'adminstatistics': 'İstatistikler',
                'admincar': 'Araba İşlemleri',
                'adminfeature': 'Araba Özellikleri',
                'adminbrand': 'Markalar',
                'adminbanner': 'Banner Alanı',
                'adminabout': 'Hakkımızda',
                'adminauthor': 'Yazar İşlemleri',
                'admincategory': 'Blog Kategorileri',
                'adminblog': 'Blog İşlemleri',
                'adminpricing': 'Ödeme Türleri',
                'admincomment': 'Yorumlar',
                'admincontact': 'İletişim',
                'adminfooteraddress': 'Alt Adres',
                'adminlocation': 'Lokasyonlar',
                'adminservice': 'Hizmetler',
                'adminsocialmedia': 'Sosyal Medya',
                'admintestimonial': 'Referanslar',
                'admintagcloud': 'Etiket Bulutu',
                'admincarfeaturedetail': 'Özellik Atama'
            };

            for (var key in titleMap) {
                if (currentPath.indexOf(key) !== -1) {
                    pageTitle = titleMap[key];
                    break;
                }
            }

            var cardTitle = $('.card-title').first().text().trim();
            var displayTitle = (cardTitle && cardTitle.length < 40) ? cardTitle : pageTitle;

            var breadcrumbHtml = `
                <div class="row">
                    <div class="col-12">
                        <div class="page-title-box d-flex align-items-center justify-content-between pb-3">
                            <h4 class="mb-0 font-size-18">${displayTitle}</h4>
                            <div class="page-title-right">
                                <ol class="breadcrumb m-0">
                                    <li class="breadcrumb-item"><a href="/Admin/Dashboard/Index">CarBook</a></li>
                                    <li class="breadcrumb-item active">${pageTitle}</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            `;

            $('.container-fluid').first().prepend(breadcrumbHtml);
        }
    });
</script>