@model List<CarBook.Dto.RentACarDtos.FilterRentACarDto>

@{
    ViewData["Title"] = "Müsait Araçlar";
    Layout = "~/Views/UILayout/Index.cshtml";
}

<section class="ftco-section bg-light">
    <div class="container">
        <div class="row">
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <div class="col-md-4">
                        <div class="car-wrap rounded ftco-animate">
                            <div class="img rounded d-flex align-items-end" style="background-image: url(@item.CoverImageUrl);">
                            </div>
                            <div class="text">
                                <h2 class="mb-0"><a href="/Car/CarDetail/@item.carID">@item.Model</a></h2>
                                <div class="d-flex mb-3">
                                    <span class="cat">@item.Brand</span>
                                </div>
                                <p class="d-flex mb-0 d-block">
                                    <a href="/Reservation/Index/@item.carID" class="btn btn-primary py-2 mr-1">Hemen Kirala</a> 
                                    <a href="/Car/CarDetail/@item.carID" class="btn btn-secondary py-2 ml-1">Detaylar</a>
                                </p>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-md-12 text-center py-5">
                    <div class="alert alert-warning">
                        <h4>Seçilen lokasyonda şu anda müsait kiralık araç bulunamadı.</h4>
                        <p class="mb-0">Lütfen farklı bir lokasyon veya tarih aralığı deneyiniz.</p>
                        <a href="/Default/Index" class="btn btn-primary mt-3">Ana Sayfaya Dön</a>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
