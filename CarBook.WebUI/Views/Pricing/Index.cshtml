@model CarBook.WebUI.Models.PricingViewModel

@{
	ViewData["Title"] = "Index";
	Layout = "~/Views/UILayout/Index.cshtml";
}

<section class="ftco-section ftco-cart">
	<div class="container">
		<div class="row">
			<div class="col-md-12 ftco-animate">
				<div class="car-list">
					<table class="table">
						<thead class="thead-primary">
							<tr class="text-center">
								<th>&nbsp;</th>
								<th>&nbsp;</th>
								@foreach (var pricingType in Model.PricingTypes)
								{
									<th class="bg-primary heading">@pricingType.Name</th>
								}
							</tr>
						</thead>
						<tbody>
							@if (Model.CarPricings.Any())
							{
								@foreach (var car in Model.CarPricings)
								{
									<tr>
										<td class="car-image">
											<div class="img" style="background-image:url(@car.CoverImageUrl);"></div>
										</td>
										<td class="product-name">
											<h3>@car.BrandName @car.Model</h3>
											<p class="mb-0 rated">
												<span>rated:</span>
												<span class="ion-ios-star"></span>
												<span class="ion-ios-star"></span>
												<span class="ion-ios-star"></span>
												<span class="ion-ios-star"></span>
												<span class="ion-ios-star"></span>
											</p>
										</td>
										@foreach (var pricingType in Model.PricingTypes)
										{
											<td class="price">
												<p class="btn-custom"><a href="#">Rent a car</a></p>
												<div class="price-rate">
													<h3>
														@if (car.Prices.TryGetValue(pricingType.Name, out var amount))
														{
															<span class="num"><small class="currency">$</small> @amount.ToString("0.00")</span>
														}
														else
														{
															<span class="num">-</span>
														}
														<span class="per">/ @pricingType.Name</span>
													</h3>
												</div>
											</td>
										}
									</tr>
								}
							}
							else
							{
								<tr>
									<td colspan="@(2 + Model.PricingTypes.Count)" class="text-center py-4">
										Henüz fiyatlandırılmış araç bulunmamaktadır.
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
</section>
