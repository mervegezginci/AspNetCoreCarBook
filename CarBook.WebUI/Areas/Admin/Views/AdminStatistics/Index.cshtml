                    <div class="card-body d-flex flex-column justify-content-between p-3">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="card-title mb-0 text-white font-size-14 text-truncate mr-2">En İyi Blog</h6>
                            <span class="badge badge-soft-light text-truncate font-size-11">En Çok Yorumlu</span>
