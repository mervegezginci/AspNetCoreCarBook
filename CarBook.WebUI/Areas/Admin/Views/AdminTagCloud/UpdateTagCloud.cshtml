@model CarBook.Dto.TagCloudDtos.UpdateTagCloudDto

@{
    ViewData["Title"] = "UpdateTagCloud";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">Etiket Güncelleme Alanı</h4>
                        <p class="card-subtitle mb-4">
                            Mevcut etiket başlığını veya ilişkili olduğu blog yazısını güncelleyebilirsiniz.
                        </p>
                        <form method="post">
                            <input type="hidden" asp-for="TagCloudID" />

                            <div class="form-group mb-3">
                                <label for="Title">Etiket Başlığı</label>
                                <input type="text" class="form-control" id="Title" asp-for="Title" required />
                            </div>

                            <div class="form-group mb-4">
                                <label for="BlogID">İlişkili Blog</label>
                                @Html.DropDownListFor(x => x.BlogID, (List<SelectListItem>)ViewBag.BlogValues, "Blog Seçiniz", new { @class = "form-control", @required = "required" })
                            </div>

                            <button type="submit" class="btn btn-primary waves-effect waves-light">Değişiklikleri Kaydet</button>
                            <a href="/Admin/AdminTagCloud/Index" class="btn btn-secondary waves-effect">İptal</a>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
