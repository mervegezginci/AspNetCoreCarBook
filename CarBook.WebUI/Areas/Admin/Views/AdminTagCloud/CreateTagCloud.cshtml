@model CarBook.Dto.TagCloudDtos.CreateTagCloudDto

@{
    ViewData["Title"] = "CreateTagCloud";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">Yeni Etiket Girişi</h4>
                        <p class="card-subtitle mb-4">
                            Bloglara ait yeni etiket tanımlamalarını bu form üzerinden gerçekleştirebilirsiniz.
                        </p>
                        <form method="post">
                            <div class="form-group mb-3">
                                <label for="Title">Etiket Başlığı</label>
                                <input type="text" class="form-control" id="Title" asp-for="Title" placeholder="Örn: Otomobil, Seyahat, Kiralama" required />
                            </div>

                            <div class="form-group mb-4">
                                <label for="BlogID">İlişkili Blog</label>
                                @Html.DropDownListFor(x => x.BlogID, (List<SelectListItem>)ViewBag.BlogValues, "Blog Seçiniz", new { @class = "form-control", @required = "required" })
                            </div>

                            <button type="submit" class="btn btn-primary waves-effect waves-light">Etiketi Kaydet</button>
                            @if (ViewBag.SelectedBlogId != null && (int)ViewBag.SelectedBlogId > 0)
                            {
                                <a href="/Admin/AdminTagCloud/TagCloudListByBlog/@ViewBag.SelectedBlogId" class="btn btn-secondary waves-effect">İptal</a>
                            }
                            else
                            {
                                <a href="/Admin/AdminTagCloud/Index" class="btn btn-secondary waves-effect">İptal</a>
                            }
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
