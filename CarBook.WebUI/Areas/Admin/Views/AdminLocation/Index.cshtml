@model List<ResultLocationDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<div class="page-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">Lokasyon Bilgileri Alaný</h4>
                        <p class="card-subtitle mb-4">
                            Ana sayfa ve araç kiralama sayfasýnda yer alan araçlarýn alýnýþ ve býrakýlýþ noktalarýný temsil eden yer lokasyon kýsmýdýr. Aþaðýda araç kiralama noktalarýna ait lokasyon bilgilerinin isimleri yer almaktadýr. Sað tarafta yer alan buton üzerinden bu lokasyonun harita bilgisine eriþim saðlayabilirsiniz.
                        </p>
                        <a href="/Admin/AdminLocation/CreateLocation" class="btn btn-primary float-right mb-3">
                            Yeni Lokasyon Giriþi
                        </a>

                        <div class="table-responsive">
                            <table class="table mb-0">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Lokasyon</th>
                                        <th>Sil</th>
                                        <th>Güncelle</th>
                                        <th>Konumu Aç</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        count++;
                                        <tr>
                                            <td>@count</td>
                                            <td>@item.Name</td>
                                            <td><a href="/Admin/AdminLocation/RemoveLocation/@item.LocationID" class="btn btn-outline-danger">Sil</a></td>
                                            <td><a href="/Admin/AdminLocation/UpdateLocation/@item.LocationID" class="btn btn-outline-success">Güncelle</a></td>
                                            <td><a href="/Admin/AdminLocation/LocationDetail/@item.LocationID" class="btn btn-outline-dark">Konumu Aç</a></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
