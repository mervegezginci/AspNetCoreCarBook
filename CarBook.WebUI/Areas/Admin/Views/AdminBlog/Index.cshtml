@model List<ResultAllBlogsWithAuthorDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<div class="page-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-body">

                        <h4 class="card-title">Blog Listesi ve İşlemleri</h4>

                        <p class="card-subtitle mb-4">
                            Bloglarla ilgili listeleme, ekleme, silme ve güncelleme işlemlerini
                            buradan gerçekleştirebilirsiniz. Ayrıca blog detaylarına ve bloglara
                            ait yorumlara erişebilirsiniz.
                        </p>

                        <div class="d-flex justify-content-end mb-3">
                            <a href="/Admin/AdminBlog/CreateBlog"
                               class="btn btn-primary">
                                Yeni Blog Girişi
                            </a>
                        </div>

                        <div class="table-responsive">
                            <table class="table mb-0">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Başlık</th>
                                        <th>Yazar</th>
                                        <th>Kategori</th>
                                        <th>Tarih</th>
                                        <th>Sil</th>
                                        <th>Güncelle</th>
                                        <th>Blogu Aç</th>
                                        <th>Yorumlar</th>
                                        <th>Etiketler</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        count++;

                                        <tr>
                                            <td>@count</td>

                                            <td>@item.Title</td>

                                            <td>@item.AuthorName</td>

                                            <td>@item.CategoryName</td>

                                            <td>@item.CreatedDate.ToString("dd.MM.yyyy")</td>

                                            <td>
                                                <a href="/Admin/AdminBlog/RemoveBlog/@item.BlogID"
                                                   class="btn btn-outline-danger">
                                                    Sil
                                                </a>
                                            </td>

                                            <td>
                                                <a href="/Admin/AdminBlog/UpdateBlog/@item.BlogID"
                                                   class="btn btn-outline-success">
                                                    Güncelle
                                                </a>
                                            </td>

                                            <td>
                                                <a href="/Blog/BlogDetail/@item.BlogID"
                                                   class="btn btn-outline-dark"
                                                   target="_blank">
                                                    Blogu Aç
                                                </a>
                                            </td>

                                            <td>
                                                <a href="/Admin/AdminComment/CommentListByBlog/@item.BlogID"
                                                   class="btn btn-outline-warning">
                                                    Yorumlar
                                                </a>
                                            </td>

                                            <td>
                                                <a href="/Admin/AdminTagCloud/TagCloudListByBlog/@item.BlogID"
                                                   class="btn btn-outline-info">
                                                    Etiketler
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>